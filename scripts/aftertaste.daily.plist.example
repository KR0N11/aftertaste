<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ca.pingchunlui.aftertaste.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.local/bin/uv</string>
        <string>run</string>
        <string>aftertaste</string>
        <string>daily</string>
        <string>--notify</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$HOME/aftertaste</string>
    <key>StandardOutPath</key>
    <string>$HOME/aftertaste/data/daily.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/aftertaste/data/daily.log</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
</dict>
</plist>
